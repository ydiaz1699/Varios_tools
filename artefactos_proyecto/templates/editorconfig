# EditorConfig — https://editorconfig.org
# Marca la raíz: los editores dejan de buscar hacia arriba.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{md,markdown}]
# No recortar espacios finales: en Markdown dos espacios = salto de línea.
trim_trailing_whitespace = false

[Makefile]
# Make EXIGE tabs reales en las recetas.
indent_style = tab
