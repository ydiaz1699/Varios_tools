# Copia este archivo a .env y rellena los valores reales.
# .env NUNCA se sube a git (debe estar en .gitignore). Este .example SÍ.

# --- Conexión / red ---
HOST=CAMBIAR_HOST_O_IP
PORT=CAMBIAR_PUERTO

# --- Secretos (NO poner valores reales aquí) ---
API_KEY=CAMBIAR_TU_API_KEY
TOKEN=CAMBIAR_TU_TOKEN

# --- Opcionales (con default razonable) ---
# LOG_LEVEL=info
# TZ=America/Guayaquil
